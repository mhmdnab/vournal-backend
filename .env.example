# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Prod (Step 11): the Supabase POOLED / Supavisor transaction string (port 6543).
DATABASE_URL="postgresql://postgres:password@localhost:5432/voice_journal"
# Prod (Step 11): the Supabase DIRECT string (port 5432) — migrations need it.
DIRECT_URL=""

# Supabase Storage (Step 11) — private bucket for audio. The service_role key
# bypasses all access control, so it is BACKEND-ONLY and never committed.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_AUDIO_BUCKET="vournal-audio"

# Anthropic API key for the extraction engine (used from Phase 2 on).
ANTHROPIC_API_KEY=""

# Optional: override the extraction model. Defaults to claude-haiku-4-5-20251001.
EXTRACTION_MODEL="claude-haiku-4-5-20251001"

# Speech-to-text. Providers: "speechmatics" (Melia — the DEFAULT as of Step 10),
# "groq", or "openai". Melia is a batch API (not OpenAI-compatible) and does
# native single-pass code-switching; groq/openai stay reachable via the seam.
STT_PROVIDER="speechmatics"
# groq: whisper-large-v3-turbo (~$0.04/hr) or whisper-large-v3 (higher accuracy)
# openai: whisper-1 (~$0.006/min) or gpt-4o-mini-transcribe (~half, text only)
# NOTE: STT_MODEL is Whisper-specific and is IGNORED for speechmatics (which
# always uses Melia / melia-1).
STT_MODEL="whisper-large-v3-turbo"
# Set the key for whichever provider STT_PROVIDER selects.
GROQ_API_KEY=""
OPENAI_API_KEY=""
# Speechmatics Melia (Step 10). Multilingual single-pass code-switching; ~$0.129/hr
# batch. No custom-vocabulary lever (unlike the Groq Lebanese primer). Region is
# eu1 (default) or us1 — jobs live in the region they were created in.
SPEECHMATICS_API_KEY=""
SPEECHMATICS_REGION="eu1"

# Merged extraction for AUDIO entries (Step 10). One Sonnet call that silently
# corrects dialect mistranscriptions (Melia hears جدّد "renew" as جدة "Jeddah")
# AND extracts — replacing the old two-call repair->extract, cheaper on realistic
# entries. Text entries still use plain EXTRACTION_MODEL (typed words need no
# repair). Override the merged model here; defaults to claude-sonnet-5.
MERGED_MODEL="claude-sonnet-5"

# The standalone repair pass (app/repair.py) is no longer in the production audio
# path — merged extraction absorbed it. These only affect the benchmark harnesses
# (benchmark_repair.py, test_merged_extraction.py) that still compare against it.
REPAIR_MODEL="claude-sonnet-5"
REPAIR_ENABLED="1"

# Auth (Step 5). JWT_SECRET signs access tokens — it MUST be strong (at least
# 32 bytes) and MUST NOT be committed. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=""
# Access token lifetime (short — it's a bearer token). Refresh token lifetime
# (long — it's revocable, stored hashed in the DB).
ACCESS_TOKEN_TTL_MIN="30"
REFRESH_TOKEN_TTL_DAYS="60"

# Cost protection / usage limits. Every audio entry costs real money, so these
# bound worst case. PLAN-AWARE (Step 14a-fix) — keyed off the effective plan, one
# value per tier. All optional (sensible defaults shown).
# Entries per calendar month, per tier: free is the low cap; daily/reflection share
# a generous fair-use ceiling (low enough to stop abuse inverting economics).
FREE_MONTHLY_ENTRY_LIMIT="15"
DAILY_MONTHLY_ENTRY_LIMIT="150"
REFLECTION_MONTHLY_ENTRY_LIMIT="150"
# Longest recording accepted, in seconds (rejected before any provider call), per
# tier: free short, daily a bit longer, reflection the longest.
FREE_MAX_RECORDING_SECONDS="90"
DAILY_MAX_RECORDING_SECONDS="120"
REFLECTION_MAX_RECORDING_SECONDS="300"
# Whole-app daily cap on NEW audio entries — the kill switch / 3am backstop.
GLOBAL_DAILY_AUDIO_CAP="500"

# Password reset (Step 11) — via Resend (resend.com). The `from` address MUST use
# your verified domain (vournal.app). WEB_BASE_URL is the web app origin used to
# build the reset link emailed to the user (/reset-password?token=...).
RESEND_API_KEY=""
RESEND_FROM="Vournal <noreply@vournal.app>"
WEB_BASE_URL="http://localhost:3000"
RESET_TOKEN_TTL_MIN="30"

# Deploy (Step 11, Phase 6). Comma-separated browser origins allowed by CORS.
# Set to the deployed web domain in production; defaults to localhost:3000 in dev.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# API reference (/docs, /redoc, /openapi.json) — OFF by default so the schema
# isn't exposed in production. Set to 1 in dev if you want the Swagger UI.
ENABLE_DOCS=""
