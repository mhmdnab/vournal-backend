datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Supavisor transaction, port 6543)
  directUrl = env("DIRECT_URL")   // direct/session (port 5432) — migrations use this
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  // 2, the minimum: at 5 the 71 models make a 20 MB types.py that can't start in 512 MB
  // (tests/test_client_size.py). The types are static only; no code imports them.
  recursive_type_depth = 2
  // Ship BOTH Linux OpenSSL engine variants alongside the local one. Render's
  // native Python host has a libssl that prisma-client-py's auto-detected target
  // (debian-openssl-3.0.x) couldn't execute; with both present, ensure() picks
  // whichever variant actually runs on the host (it runs `engine --version` and
  // selects the one that succeeds). "native" keeps local dev (macOS) working.
  binaryTargets        = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
  // vournal OS stores money as Decimal(14,2); the Python client gates it behind this flag.
  enable_experimental_decimal = true
}

enum EntrySource {
  TEXT
  VOICE
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// Subscription tiers. Lowercase to match what the API returns and the clients gate
// on. Two tiers only: `free` (the default for everyone) and `plus` — the single
// paid plan (~$4/mo: longer recordings, higher caps, and the premium AI features
// when they land). Collapsed from the old free/daily/reflection split.
enum Plan {
  free
  plus
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nullable so `db push` accepts the pre-auth demo row, and so future
  // OAuth-only accounts (Apple/Google, a later step) can exist without a
  // password. Registration always sets it; login rejects null-password users.
  passwordHash String?
  emailVerifiedAt DateTime?
  // Signed up on an app that asks for the code: login asks again until confirmed.
  // Older accounts stay false and are never blocked.
  emailConfirmRequired Boolean @default(false)
  // Sign in with Apple's refresh token, encrypted: deleting the account revokes it.
  appleRefreshToken String?
  // Raised when old sessions must die at once. Every token carries the generation
  // it was issued for, so a refresh or login racing the change dies with them.
  sessionGeneration Int @default(0)
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  twoFactorLastStep Int @default(-1)
  recoveryCodeHashes String[] @default([])
  // IANA timezone name (e.g. "Asia/Beirut"), sent by the client on register.
  // null = UTC fallback. Used to compose spoken clock times into the correct UTC
  // instant and to bucket the mood trend by the user's local day.
  timezone     String?
  // Usage metering (Step 11). Rolls at the calendar month: usagePeriodStart is
  // the UTC first-of-month for the current window, usagePeriodEntries is how many
  // entries have been created in it. Bounds per-user cost.
  usagePeriodStart   DateTime?
  usagePeriodEntries Int      @default(0)
  // Subscription entitlement (Step 14a). `plan` is the granted tier and
  // `planExpiresAt` when it lapses; access is ALWAYS resolved through
  // app.entitlements.effective_plan(), which falls back to `free` once the expiry
  // passes (fail-safe) — nothing reads `plan` directly. The paddle* ids are added
  // now so the later Paddle payment step needs no second migration; unused today.
  plan                 Plan      @default(free)
  planExpiresAt        DateTime?
  paddleCustomerId     String?
  paddleSubscriptionId String?
  // Billing (build 5). appAccountToken is the UUID the app attaches to every App
  // Store purchase so a transaction maps back to this user; created on demand.
  // planSource says which grant set the current planExpiresAt ("apple" | "paddle"
  // | "manual"). Written only through app.entitlements.grant_plus/revoke_plus.
  appAccountToken            String? @unique
  appleOriginalTransactionId String? @unique
  planSource                 String?
  // When Apple last refunded/revoked this user's subscription. A signed
  // transaction bought before this moment never grants Plus again (stale replay).
  appleRevokedAt             DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  entries       Entry[]
  todos         Todo[]
  topics        Topic[]
  people        Person[]
  places        Place[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  authChallenges AuthChallenge[]
  externalIdentities ExternalIdentity[]

  // vournal OS (web dashboard)
  settings          UserSettings?
  categories        Category[]
  tags              Tag[]
  exchangeRates     ExchangeRate[]
  tasks             Task[]
  events            Event[]
  projects          Project[]
  attachments       Attachment[]
  accounts          Account[]
  transactions      Transaction[]
  budgets           Budget[]
  recurringPayments RecurringPayment[]
  goals             Goal[]
  habits            Habit[]
  habitLogs         HabitLog[]
  maintenanceItems  MaintenanceItem[]
  maintenanceLogs   MaintenanceLog[]
  documents         Document[]
  shoppingLists     ShoppingList[]
  shoppingItems     ShoppingItem[]
  recipes           Recipe[]
  mealPlanEntries   MealPlanEntry[]
  notes             Note[]
  courses           Course[]
  assessments       Assessment[]
  studySessions     StudySession[]
  trips             Trip[]
  importantDates    ImportantDate[]
  reminders         Reminder[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  activityLogs      ActivityLog[]
  dayLogs           DayLog[]
  weekReviews       WeekReview[]
  householdMember   HouseholdMember?
  assistantChats    AssistantConversation[]
  debts             Debt[]
  debtPayments      DebtPayment[]
  healthProfile     HealthProfile?
  foodItems         FoodItem[]
  foodLogs          FoodLog[]
  exerciseLogs      ExerciseLog[]
  weightLogs        WeightLog[]
  waterLogs         WaterLog[]
  challenges        Challenge[]
  workoutPlans      WorkoutPlan[]
  workoutSessions   WorkoutSession[]
}

// Prepared for credentialed provider adapters; identity is issuer+subject,
// never an email address or a client-asserted user id.
model ExternalIdentity {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer String
  subject String
  createdAt DateTime @default(now())

  @@unique([issuer, subject])
  @@index([userId])
}

// Email-code challenges. Raw tokens/codes are never stored here.
model AuthChallenge {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  purpose String
  codeHash String?
  pendingSecret String?
  // The provider identity to link once the code proves this email is theirs.
  pendingIssuer String?
  pendingSubject String?
  attempts Int @default(0)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, purpose])
}

// Password-reset tokens (Step 11). Like refresh tokens, only the SHA-256 hash is
// stored (never the token). Single-use (usedAt) and short-lived (expiresAt).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Opaque refresh tokens, stored as a SHA-256 hash (never the token itself) so
// they can be revoked (logout) and rotated (refresh). Access tokens are stateless
// JWTs; only refresh tokens live here.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  mfaVerified Boolean @default(false)
  generation Int @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Entry {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  source        EntrySource      @default(TEXT)
  audioUrl      String?
  durationSec   Int?
  rawTranscript String
  summary       String?
  moodScore     Int? // 1 (very negative) .. 5 (very positive)
  moodLabel     String?
  emotions      String[]
  status        ProcessingStatus @default(PENDING)
  processedAt   DateTime?
  error         String?
  // Actual resources consumed by this entry (Step 11) — turns unit-economics
  // estimates into data. sttSeconds: audio seconds sent to STT (VOICE only);
  // llmInTokens/llmOutTokens: extraction (or merged) token usage.
  sttSeconds    Float?
  llmInTokens   Int?
  llmOutTokens  Int?
  createdAt     DateTime         @default(now())

  todos  Todo[]
  topics EntryTopic[]
  people EntryPerson[]
  places EntryPlace[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model Todo {
  id        String    @id @default(cuid())
  entryId   String
  entry     Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  dueDate   DateTime? // the DAY the task is for (day-precision), if any
  startAt   DateTime? // dueDate + a spoken time; null = untimed. Timed items are
  //           the ones that become calendar events (next step).
  done      Boolean   @default(false)
  kind String @default("task")
  urgency Int @default(0)
  urgencyUnclear Boolean @default(false)
  category String @default("personal")
  location String?
  locationLatitude Float?
  locationLongitude Float?
  recurrence String?
  recurrenceUnclear Boolean @default(false)
  recurrenceInterval Int @default(1)
  recurrenceWeekdays String[] @default([]) // "MO".."SU" for weekly repeats
  recurrenceUntil DateTime?
  calendarRequested Boolean @default(false)
  remindersRequested Boolean @default(false)
  dismissedQuestions String[] @default([])
  createdAt DateTime  @default(now())

  @@index([userId, done])
  @@index([userId, startAt])
}

model Topic {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  // Comparison key (app.entities.normalize_name): case/whitespace/Arabic-variant
  // folded. (userId, normalizedName) is the real uniqueness — the same surface form
  // can't make two rows. `name` stays the display form.
  normalizedName String
  // Alternate display surfaces this entity also answers to (Step 17, Phase 4). A
  // merge folds the absorbed entity's name+aliases in here so both surface forms
  // survive; when a surface form is an alias of 2+ entities, its chip reads as
  // ambiguous. Display strings — normalization is applied on the fly.
  aliases String[] @default([])

  entries EntryTopic[]

  @@unique([userId, normalizedName])
}

model EntryTopic {
  entryId String
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([entryId, topicId])
  @@index([topicId]) // reverse lookup: a topic's moments (thread queries)
}

model Person {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  // See Topic.normalizedName — same folding, same (userId, normalizedName) key.
  normalizedName String
  aliases        String[] @default([]) // see Topic.aliases (Step 17, Phase 4)

  entries EntryPerson[]

  // vournal OS fields: all optional, so the app's people keep working unchanged
  relationship       String? // "Family", "Friend", "Colleague"...
  birthday           DateTime? @db.Date
  birthdayHasYear    Boolean   @default(true) // false → only day/month are meaningful
  anniversary        DateTime? @db.Date
  email              String?
  phone              String?
  notes              String?
  avatarColor        String?
  reminderDaysBefore Int?      @default(3)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  importantDates     ImportantDate[]
  giftIdeas          GiftIdea[]
  debts              Debt[]
  notesList          Note[]

  @@unique([userId, normalizedName])
}

model EntryPerson {
  entryId  String
  entry    Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([entryId, personId])
  @@index([personId]) // reverse lookup: a person's moments (thread queries)
}

// Places mirror Person/Topic exactly (Step 17): same normalizedName folding, same
// (userId, normalizedName) uniqueness, same known-list continuity. Forward-only —
// old entries have no places; they populate as new entries mention locations.
model Place {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  aliases        String[] @default([]) // see Topic.aliases (Step 17, Phase 4)

  entries EntryPlace[]

  @@unique([userId, normalizedName])
}

model EntryPlace {
  entryId String
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([entryId, placeId])
  @@index([placeId]) // reverse lookup: a place's moments (thread queries)
}

// A web (Paddle) purchase whose email matched no account yet. Applied when an
// account with that email is created; externalId is the Paddle subscription id.
model PendingGrant {
  id         String    @id @default(cuid())
  email      String
  source     String
  externalId String    @unique
  expiresAt  DateTime
  appliedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

// =============================================================================
// vournal OS — the web dashboard's data (ported from vournalOS-backend).
// Every model belongs to the app's User; Person above is shared with the app.
// Conventions from vournal OS:
//  * Every user-owned row has `userId` and every query MUST filter by it.
//  * Money = Decimal(14,2) + `currency` (ISO-4217 string, e.g. "USD", "LBP").
//  * Recurrence = RFC-5545 RRULE body WITHOUT DTSTART; the row's own anchor
//    date (startAt / dueAt / nextDate / ...) is DTSTART.
//  * Date-only values use @db.Date. Instants use DateTime (UTC).
// =============================================================================

