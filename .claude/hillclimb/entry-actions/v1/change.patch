diff --git a/app/entry_actions.py b/app/entry_actions.py
index b2ca1f0..06eba88 100644
--- a/app/entry_actions.py
+++ b/app/entry_actions.py
@@ -84,6 +84,24 @@ async def _entry_block(entry, user_id: str, ctx: assistant_tools.Ctx) -> str:
             ctx.entry_people[placeholder] = name
             lines.append(f'[{index}] {name} (new: use "{placeholder}" as their id)')
     lines.append("</entry>")
+    lines.append(await _their_items(user_id))
+    return "\n".join(lines)
+
+
+async def _their_items(user_id: str) -> str:
+    """The user's habits, projects and goals, so the step can act on them without searching."""
+    habits = await db.habit.find_many(where={"userId": user_id, "isArchived": False}, order={"sortOrder": "asc"}, take=40)
+    projects = await db.project.find_many(where={"userId": user_id, "status": {"in": ["PLANNING", "ACTIVE", "ON_HOLD"]}}, take=40)
+    goals = await db.goal.find_many(where={"userId": user_id, "status": {"in": ["ACTIVE", "PAUSED"]}}, take=40)
+
+    def habit(h) -> str:
+        target = f", {h.targetPerDay} {h.unit or 'times'} a day" if h.targetPerDay > 1 or h.unit else ""
+        return f"- {h.name} (id {h.id}{target})"
+
+    lines = ["<their_items>", "Habits:" if habits else "Habits: none", *map(habit, habits)]
+    lines += ["Projects:" if projects else "Projects: none", *(f"- {p.name} (id {p.id}, {p.status.lower()})" for p in projects)]
+    lines += ["Goals:" if goals else "Goals: none", *(f"- {g.name} (id {g.id})" for g in goals)]
+    lines.append("</their_items>")
     return "\n".join(lines)
 
 
diff --git a/app/extraction.py b/app/extraction.py
index f591230..e219466 100644
--- a/app/extraction.py
+++ b/app/extraction.py
@@ -126,7 +126,7 @@ Rules:
 - topics: normalize to general, reusable ENGLISH nouns so they aggregate across days. Prefer "work", "sleep", "health", "family", "money", "relationship" over hyper-specific phrases. This is what powers "you talked about sleep 5 times this week", so favor stable labels.
 - people: use the name as spoken. If the speaker refers to someone only by role ("my boss", "my sister") and no name, you may include that role. Skip vague references. [] if none.
 - places: SPECIFIC named locations the speaker was at, went to, or is going to — a city, neighborhood, venue, or a named personal place ("Beirut", "Hamra", "the gym", "the office", "Mom's"). Use the name as spoken (keep the original language). Do NOT include vague or generic locations ("home", "outside", "there", "somewhere"), and do NOT invent a place that was not mentioned. [] if none.
-- wantsActions: true when the speaker mentions spending or receiving money, a habit done or skipped, a project, food eaten or drunk, exercise or weight, a gift, a goal, a change to something that already exists, or asks for something to be done in vournal. To-dos and plans alone do NOT count. Otherwise false.
+- wantsActions: true when the speaker mentions spending or receiving money, a habit done or skipped (any activity people track as a habit: exercise, reading, meditating, walking, praying and the like), a project, food eaten or drunk, exercise or weight, a gift, a goal, a birthday, anniversary or other date tied to a person, something to remember about a person, a change to something that already exists, or asks for something to be done in vournal. To-dos and plans alone do NOT count. Otherwise false.
 - journalSuggested: false only when the whole entry is a command with nothing about the speaker's day, thoughts or feelings (e.g. "create a project called Vournal 2"). Otherwise true.
 - If the transcript is empty or has no real content, return the object with an empty summary, mood.score 3, and empty arrays.
 
