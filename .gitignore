# Environment / secrets — ignore every .env variant (incl. .env.bak-portmove)
# EXCEPT the committed, secret-free template.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Prisma generated client (regenerated via `prisma generate`)
.prisma/
.local-enhancements/

# OS / editor
.DS_Store
.idea/
.vscode/

# Audio (dev) — keep the samples README, ignore the recordings + uploads
uploads/
samples/*
!samples/README.md

# AI evals: keep cases, runner, per-round results and notes; leave out bulky or local output
.claude/hillclimb/**/traces/
.claude/hillclimb/**/report*.html
.claude/hillclimb/**/state.json
.claude/hillclimb/**/trajectory/
.claude/hillclimb/**/.harness_sha
.claude/hillclimb/**/fake-*/
.claude/hillclimb/**/*.before-label-fix.jsonl
