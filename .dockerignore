# NEVER copy secrets or the local (macOS) virtualenv into the image.
.env
.env.*
!.env.example
.venv
venv
env

# Python caches / artifacts
__pycache__
*.pyc
*.pyo
*.egg-info
.pytest_cache
.mypy_cache

# VCS + editor + OS
.git
.gitignore
.DS_Store
.idea
.vscode

# Dev-only data + docs (not needed at runtime)
uploads
samples
*.md
